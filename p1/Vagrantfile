SERVER_NAME = "yaskourS"
WORKER_NAME = "yaskourSW"

SERVER_IP = "192.168.56.110"
WORKER_IP = "192.168.56.111"

Vagrant.configure("2") do |config|
  config.vm.box = "debian/bookworm64" #  NOTE: this should be changed to a and actual box_url (we should choose a distro)

  config.vm.define SERVER_NAME do |serverConfig|
    serverConfig.vm.network "private_network", ip: SERVER_IP
    serverConfig.vm.hostname = SERVER_NAME

    serverConfig.vm.provider "virtualbox" do |virtualBoxConfig|
        virtualBoxConfig.memory =  2048
        virtualBoxConfig.cpus = 2
    end
    serverConfig.vm.provision :shell, path: "server.sh"
  end

  config.vm.define WORKER_NAME do |workerServerConfig|
    workerServerConfig.vm.network "private_network", ip: WORKER_IP
    workerServerConfig.vm.hostname = WORKER_NAME
    workerServerConfig.vm.provider "virtualbox" do |virtualBoxConfig|
        virtualBoxConfig.memory =  1048
        virtualBoxConfig.cpus = 1
    end
    workerServerConfig.vm.provision :shell, path: "worker.sh"
  end
end
